{
  "name": "@airdrop/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server-client.ts",
    "./collection-worker": {
      "browser": "./src/collection/browser-denied.ts",
      "default": "./src/collection/worker-entry.ts"
    },
    "./collection-queue-worker": {
      "browser": "./src/queue/browser-denied.ts",
      "default": "./src/queue/worker-entry.ts"
    },
    "./schedule-admin": {
      "browser": "./src/queue/admin-browser-denied.ts",
      "default": "./src/queue/admin-entry.ts"
    },
    "./promotion-worker": {
      "browser": "./src/promotion/browser-denied.ts",
      "default": "./src/promotion/worker-entry.ts"
    },
    "./failed-ai-run-review": {
      "browser": "./src/review/browser-denied.ts",
      "default": "./src/review/entry.ts"
    },
    "./security-review": {
      "browser": "./src/security/browser-denied.ts",
      "default": "./src/security/entry.ts"
    },
    "./reference-review": {
      "browser": "./src/references/browser-denied.ts",
      "default": "./src/references/entry.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/require-integration-env.mjs && vitest run --no-file-parallelism src/tests/project-repository.integration.test.ts src/tests/source-collection-repository.integration.test.ts src/tests/durable-queue-repository.integration.test.ts src/tests/schedule-command-repository.integration.test.ts src/tests/scoring-repository.integration.test.ts src/tests/promotion-repository.integration.test.ts src/tests/failed-ai-run-review-repository.integration.test.ts src/tests/security-review-repository.integration.test.ts src/tests/security-candidate-ingress.integration.test.ts src/tests/reference-review-repository.integration.test.ts src/tests/reference-security-coupling.integration.test.ts"
  },
  "dependencies": {
    "@airdrop/contracts": "workspace:*",
    "@supabase/supabase-js": "^2.112.2",
    "postgres": "^3.4.9",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0"
  }
}
