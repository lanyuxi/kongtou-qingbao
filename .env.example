# Public browser configuration for local Supabase.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key

# Server-only database login with membership only to SET ROLE collection_schedule_admin.
# It must have execute permission on the schedule command function and no direct table DML.
AIRDROP_QUEUE_ADMIN_DATABASE_URL=postgresql://collection_schedule_admin_login:local-password@127.0.0.1:54322/postgres

# Server-only database login for the worker durable collection queue repository.
AIRDROP_QUEUE_DATABASE_URL=postgresql://collection_queue_worker_login:local-password@127.0.0.1:54322/postgres

# Server-only database login used by the source collector.
AIRDROP_COLLECTION_DATABASE_URL=postgresql://collection_worker_login:local-password@127.0.0.1:54322/postgres

# Outbound HTTPS user agent for collection requests (printable ASCII, 1-255 characters).
AIRDROP_COLLECTION_USER_AGENT=airdrop-intelligence-os/0.0.0 (+https://example.invalid)

# Stable identity for this worker instance in queue leases (printable ASCII, 1-64 characters).
AIRDROP_QUEUE_WORKER_ID=local-worker-1
