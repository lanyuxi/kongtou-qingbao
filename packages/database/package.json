{
  "name": "@airdrop/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server-client.ts",
    "./collection-worker": {
      "browser": "./src/collection/browser-denied.ts",
      "default": "./src/collection/worker-entry.ts"
    },
    "./collection-queue-worker": {
      "browser": "./src/queue/browser-denied.ts",
      "default": "./src/queue/worker-entry.ts"
    },
    "./schedule-admin": {
      "browser": "./src/queue/admin-browser-denied.ts",
      "default": "./src/queue/admin-entry.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/require-integration-env.mjs && vitest run --no-file-parallelism src/tests/project-repository.integration.test.ts src/tests/source-collection-repository.integration.test.ts src/tests/durable-queue-repository.integration.test.ts src/tests/schedule-command-repository.integration.test.ts src/tests/scoring-repository.integration.test.ts"
  },
  "dependencies": {
    "@airdrop/contracts": "workspace:*",
    "@supabase/supabase-js": "^2.112.2",
    "postgres": "^3.4.9",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0"
  }
}
